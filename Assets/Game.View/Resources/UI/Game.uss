.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.win {
    border-width: 1px;
    border-color: rgb(6, 7, 9);
    background-color: rgba(26, 28, 34, 0.96);
    margin: 4px;
}

.win-inner {
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(78, 84, 100);
    border-left-color: rgb(78, 84, 100);
    border-bottom-color: rgb(14, 15, 18);
    border-right-color: rgb(14, 15, 18);
    padding: 6px 8px;
}

.bar-strip .win-inner {
    padding: 3px 8px;
}

.row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.row-top {
    align-items: flex-start;
}

.col {
    flex-direction: column;
}

.flex {
    flex-grow: 1;
}

.text {
    font-size: 13px;
    color: rgb(230, 230, 230);
    white-space: normal;
    padding: 1px 2px;
    margin: 0;
}

.small {
    font-size: 11px;
    color: rgb(208, 208, 208);
}

.title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 214, 122);
    margin-bottom: 2px;
}

.btn {
    font-size: 12px;
    color: rgb(238, 238, 238);
    background-color: rgb(58, 63, 76);
    border-radius: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(98, 105, 124);
    border-left-color: rgb(98, 105, 124);
    border-bottom-color: rgb(20, 22, 27);
    border-right-color: rgb(20, 22, 27);
    padding: 2px 6px;
    margin: 1px 2px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.btn:hover {
    background-color: rgb(74, 81, 99);
}

.btn:active {
    background-color: rgb(42, 46, 56);
    border-top-color: rgb(20, 22, 27);
    border-left-color: rgb(20, 22, 27);
    border-bottom-color: rgb(98, 105, 124);
    border-right-color: rgb(98, 105, 124);
}

.btn:disabled {
    opacity: 0.45;
}

.btn.on {
    background-color: rgb(110, 92, 36);
    border-top-color: rgb(214, 180, 80);
    border-left-color: rgb(214, 180, 80);
    border-bottom-color: rgb(60, 48, 16);
    border-right-color: rgb(60, 48, 16);
}

.btn.ready {
    background-color: rgb(46, 86, 50);
}

.btn.left {
    -unity-text-align: middle-left;
}

.btn.tool {
    font-size: 11px;
    min-width: 92px;
    height: 44px;
}

.btn.tab {
    height: 30px;
    min-width: 110px;
}

.check {
    width: 18px;
    height: 18px;
    padding: 0;
    font-size: 12px;
}

.bar-bg {
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgb(10, 10, 12);
    margin: 1px 4px;
    flex-shrink: 0;
}

.bar-fill {
    height: 100%;
}

.swatch {
    height: 4px;
    margin: 0 2px;
}

.tooltip {
    position: absolute;
    max-width: 380px;
    background-color: rgba(14, 15, 19, 0.97);
    border-width: 1px;
    border-color: rgb(120, 110, 80);
    padding: 4px 6px;
    font-size: 12px;
    color: rgb(240, 240, 240);
    white-space: normal;
}

.hint {
    position: absolute;
    left: 10px;
    bottom: 64px;
    font-size: 11px;
    color: rgb(220, 220, 220);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.site {
    position: absolute;
    width: 190px;
    height: 96px;
    padding: 4px 6px;
    border-width: 2px;
    border-color: rgb(12, 12, 14);
}

.scroll {
    flex-shrink: 1;
}
